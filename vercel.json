{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "kore.ciflow.io"
        }
      ],
      "dest": "/kore/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}